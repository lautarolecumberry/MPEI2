		{"id":"afeb22005bfd417f","type":"text","text":"La practica se prueba con hechos","x":996,"y":436,"width":250,"height":60},
		{"id":"b05a302c1fd801b1","type":"text","text":"Prueba: Lo debe probar quien dice que existe la costumbre","x":655,"y":471,"width":250,"height":71},
		{"id":"1ec72fedc32ed4a0","type":"text","text":"La opinio juris se prueba con votos en ONU, conferencias internacionales, etc","x":999,"y":536,"width":361,"height":60},
		{"id":"269da33882809ca2","type":"text","text":"Costumbre internacional:  \nfundamental para areas  \ndonde no hay tratados","x":253,"y":350,"width":250,"height":91},
		{"id":"2de0ebc98dafe0c9","type":"text","text":"Fuentes principales","x":-100,"y":365,"width":250,"height":60},
		{"id":"120b28c68fedc80b","type":"text","text":"Son las que pueden crear  \nmodificar o extinguir normas","x":-100,"y":451,"width":250,"height":60,"color":"2"},
