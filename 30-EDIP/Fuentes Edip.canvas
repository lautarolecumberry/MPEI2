		{"id":"9a64bba64a0aa043","type":"text","text":"Opinio juris","x":999,"y":335,"width":250,"height":60},
		{"id":"afeb22005bfd417f","type":"text","text":"La practica se prueba con hechos","x":996,"y":436,"width":250,"height":60},
		{"id":"b05a302c1fd801b1","type":"text","text":"Prueba: Lo debe probar quien dice que existe la costumbre","x":655,"y":471,"width":250,"height":71},
		{"id":"1ec72fedc32ed4a0","type":"text","text":"La opinio juris se prueba con votos en ONU, conferencias internacionales, etc","x":999,"y":536,"width":361,"height":60},
		{"id":"269da33882809ca2","type":"text","text":"Costumbre internacional:  \nfundamental para areas  \ndonde no hay tratados","x":253,"y":350,"width":250,"height":91},
		{"id":"2de0ebc98dafe0c9","type":"text","text":"Fuentes principales","x":-100,"y":365,"width":250,"height":60},
		{"id":"120b28c68fedc80b","type":"text","text":"Son las que pueden crear  \nmodificar o extinguir normas","x":-100,"y":451,"width":250,"height":60,"color":"2"},
		{"id":"7f2c689675db507f","type":"text","text":"Tratados internacionales","x":253,"y":60,"width":250,"height":60},
		{"id":"6a1b80c2c0ff67e8","type":"text","text":"Fuentes auxiliares","x":-100,"y":780,"width":250,"height":60},
		{"id":"b4388d08ca1355dd","type":"text","text":"El medio en si mismo (tratado, ley, contrato)","x":205,"y":-240,"width":250,"height":60,"color":"2"},
		{"id":"b361e61547caa2d6","type":"text","text":"Son las causas politicas, sociales o culturales  \nque llevan a la norma","x":205,"y":-145,"width":250,"height":110,"color":"2"},
		{"id":"fdd7f8ceaeece52b","type":"text","text":"Fuentes formales","x":-100,"y":-240,"width":250,"height":60},
		{"id":"0374b82592e91989","type":"text","text":"Fuentes materiales","x":-100,"y":-120,"width":250,"height":60},
		{"id":"82569c613702f7db","type":"text","text":"Objetor persistente: evita la costumbre si se opne desde el inicio de la norma y de manera continua","x":655,"y":623,"width":417,"height":78},
		{"id":"cec2ec43c583a2c4","x":503,"y":1080,"width":402,"height":220,"type":"text","text":"Obligaciones erga omnes:\n* Los Estados las asumen frente a toda la comunidad internacional. Ej: proscripcion de los actos de genocidio\n* Todos los E tienen un interes juridico en su proteccion y pueden reclamar su incumplimiento"},
		{"id":"b4737fc1f0cd153d","x":655,"y":750,"width":417,"height":90,"type":"text","text":"Principios generales de derecho vs principios de derecho internacional (preg 12)"},
		{"id":"8271730593963ec7","type":"text","text":"Principios generales de derecho","x":253,"y":766,"width":250,"height":59},
		{"id":"93fc9c691f6b1fd1","type":"text","text":"Normas imperativa (jus cogens): \nSolo se pueden modificar por otra norma imperativa","x":-100,"y":1140,"width":478,"height":100},
		{"id":"9f03c155a6c2f75f","x":-100,"y":1340,"width":250,"height":80,"type":"text","text":"Equidad (preg 11)"},
		{"id":"e9a2004c0d5fbfff","type":"text","text":"Normas dispositivas: \nDos Estados pueden derogarlas o modificarlas","x":-100,"y":1020,"width":478,"height":80},
		{"id":"d4a0292eaf1b92d8","x":-100,"y":1520,"width":478,"height":160,"type":"text","text":"Acto unilateral del Estado\n* Def: manifestacion de voluntad autonoma de un E.\n* Ej: La promesa como las declaeraciones de Francia en el caso de Ensayos Nucleares"}
